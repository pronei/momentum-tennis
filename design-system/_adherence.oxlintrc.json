        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute[name.name='mobileMode'] > Literal[value!=/^(?:bottom|scroll)$/]",
        "message": "<Tabs> mobileMode must be one of 'bottom' | 'scroll'."
