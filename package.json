{
	"name": "momentumtennis",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . && node scripts/check-adherence.mjs",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"db:test": "node supabase/tests/validate.mjs",
		"db:types": "node scripts/gen-db-types.mjs",
		"env:check": "node scripts/check-env.mjs",
		"build:dev": "node scripts/build-env.mjs dev",
		"build:live": "node scripts/build-env.mjs prod"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260901.1",
		"@electric-sql/pglite": "^0.5.8",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.11",
		"wrangler": "^4.128.0",
		"yaml": "^2.9.0"
	},
	"dependencies": {
		"@supabase/ssr": "^0.12.5",
		"@supabase/supabase-js": "^2.112.4",
		"resend": "^6.25.0",
		"stripe": "^22.6.0",
		"sveltekit-superforms": "^2.30.2",
		"zod": "^4.5.4"
	},
	"packageManager": "pnpm@11.1.2"
}
