# ═══════════════════════════════════════════════════════════════════
# Momentum Tennis — environment variable reference (canonical list)
#
# Same variable NAMES in every environment; only VALUES differ.
#   local dev   → .env.development (committed, public values)
#                 + .env.local     (gitignored, your secrets)
#   deployed    → momentum-tennis-dev / momentum-tennis Cloudflare
#                 projects: public values baked by `pnpm build:dev|live`,
#                 secrets via `wrangler secret put` / dashboard.
# Secrets NEVER go in committed files. `pnpm env:check` refuses if one does.
# Each environment is described in config/<env>.yaml; setup in docs/OPERATIONS.md.
# ═══════════════════════════════════════════════════════════════════

# ── core (required — nothing renders without these) ──────────────
PUBLIC_SUPABASE_URL=             # https://<project-ref>.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY= # sb_publishable_… — safe to expose, RLS is the guard
PUBLIC_SITE_URL=                 # canonical origin for links/redirects/emails
EMAIL_FROM=                      # e.g. "Momentum Tennis <no-reply@momentum-tennis.com>"

# ── integration secrets (gitignored .env.local / CF secrets ONLY) ──
# Each is demanded only by the code that uses it, so leave the ones for
# phases that have not shipped unset — the app still runs.
SUPABASE_SECRET_KEY=             # sb_secret_… bypasses RLS — webhooks (phase 5), cron (phase 7)
STRIPE_SECRET_KEY=               # sk_test_… (dev) / sk_live_… (prod) — phase 5
STRIPE_WEBHOOK_SECRET=           # whsec_… — one per webhook endpoint per environment — phase 5
RESEND_API_KEY=                  # phase 4 confirmations / phase 7
CRON_SHARED_SECRET=              # ≥16 chars; authenticates workers/cron → /internal/cron — phase 7

# ── operator-only (scripts read these; the app never does) ────────
SUPABASE_DB_PASSWORD_DEV=        # dashboard → Settings → Database — `pnpm db:push dev`
SUPABASE_DB_PASSWORD_PROD=       # `pnpm db:push prod`
CLOUDFLARE_API_TOKEN=            # optional: `pnpm cf` without `pnpm cf login` — a token for THIS account only
CLOUDFLARE_ACCOUNT_ID=           # optional: otherwise config/dev.yaml cloudflare.account_id
