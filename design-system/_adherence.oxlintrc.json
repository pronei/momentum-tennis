        "selector": "JSXOpeningElement[name.name='StatusChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|tone|style|key|ref|className|style|children)$/]",
        "message": "<StatusChip> doesn't accept that prop. Declared props: status, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusChip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|field)$/]",
        "message": "<StatusChip> tone must be one of 'light' | 'field'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StrobeArc'] > JSXAttribute > JSXIdentifier[name!=/^(?:frames|tone|showPath|annotate|ballRadius|width|height|style|key|ref|className|style|children)$/]",
        "message": "<StrobeArc> doesn't accept that prop. Declared props: frames, tone, showPath, annotate, ballRadius, width, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StrobeArc'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|field)$/]",
        "message": "<StrobeArc> tone must be one of 'light' | 'field'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|onChange|mobileMode|ariaLabel|style|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: items, active, onChange, mobileMode, ariaLabel, style."
      },
