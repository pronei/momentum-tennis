# ═══════════════════════════════════════════════════════════════════
# Momentum Tennis — environment variable reference (canonical list)
#
# Same variable NAMES in every environment; only VALUES differ.
#   local dev   → .env.development (committed, public values)
#                 + .env.local     (gitignored, your secrets)
#   deployed    → momentumtennis-dev / momentumtennis Cloudflare
#                 projects: public values as project env vars,
#                 secrets via `wrangler secret put` / dashboard.
# Secrets NEVER go in committed files.
# ═══════════════════════════════════════════════════════════════════

# ── public (client-safe; PUBLIC_ prefix = exposed to browser) ──
PUBLIC_SUPABASE_URL=            # https://<project-ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=       # publishable key — safe to expose, RLS is the guard
PUBLIC_SITE_URL=                # canonical origin for links/redirects/emails

# ── server config (non-secret, per-environment) ────────────────
EMAIL_FROM=                     # e.g. "Momentum Tennis <no-reply@momentum-tennis.com>"

# ── server secrets (gitignored .env.local / CF secrets ONLY) ───
SUPABASE_SERVICE_ROLE_KEY=      # bypasses RLS — webhooks, cron, admin server ops only
STRIPE_SECRET_KEY=              # sk_test_… (dev) / sk_live_… (prod)
STRIPE_WEBHOOK_SECRET=          # whsec_… — one per webhook endpoint per environment
RESEND_API_KEY=
CRON_SHARED_SECRET=             # authenticates the cron worker → internal endpoints
# SUPABASE_DB_URL=              # direct DB URL — CI migrations only, never app runtime
