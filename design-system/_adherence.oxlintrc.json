        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|help|error|placeholder|type|name|defaultValue|value|onChange|ballCaret|disabled|style|inputStyle|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, help, error, placeholder, type, name, defaultValue, value, onChange, ballCaret, disabled, style, inputStyle."
