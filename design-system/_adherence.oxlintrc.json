        "message": "<Wordmark> variant must be one of 'lockup' | 'word' | 'mark'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
